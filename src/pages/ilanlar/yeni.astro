---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sectors } from '../../data/platform';
import { categories } from '../../data/market-demo';
import '../../styles/market.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => base + path;
---
<BaseLayout title="İlan Verme Ekranı — Pilot" description="Satılık ve kiralık makine ilanı oluşturma ekranının etkileşimli pilotu." noindex={true}>
  <section class="market-detail-head"><div class="container">
    <nav class="market-crumb" aria-label="Konum"><a href={href('/')}>Ana sayfa</a><span>/</span><a href={href('/ilanlar/')}>Makine Pazarı</a><span>/</span><span>İlan verme taslağı</span></nav>
    <span class="eyebrow">Pilot form</span>
    <h1>İlanını oluştur.</h1>
    <p class="market-form-intro">Bilgileri doldurup ilan kartının önizlemesini görebilirsin. Bu denemede form hiçbir yere gönderilmez veya kaydedilmez.</p>
  </div></section>

  <section class="section market-section"><div class="container market-form-layout">
    <form id="market-form" class="market-form">
      <div class="market-form-section">
        <div class="market-form-heading"><span>01</span><div><h2>Ne sunuyorsun?</h2><p>İlan türünü ve ekipmanın bulunacağı sektörleri seç.</p></div></div>
        <div class="market-form-grid">
          <fieldset class="market-form-offer"><legend>İlan türü *</legend>
            <label><input type="radio" name="offer" value="sale" checked /><span>Satılık</span></label>
            <label><input type="radio" name="offer" value="rent" /><span>Kiralık</span></label>
          </fieldset>
          <label class="market-field"><span>Makine / parça türü *</span><select name="category" required><option value="">Seçiniz</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
        </div>
        <fieldset class="market-sector-picker"><legend>Sektörler * <small>Birden fazla seçebilirsin.</small></legend>
          {sectors.map((sector) => <label><input type="checkbox" name="sectors" value={sector.slug} /><span>{sector.title}</span></label>)}
        </fieldset>
        <p class="market-form-error" id="sector-error" role="alert" hidden>En az bir sektör seçmelisin.</p>
      </div>

      <div class="market-form-section">
        <div class="market-form-heading"><span>02</span><div><h2>Makineyi anlat.</h2><p>Alıcının ilk bakışta bilmek isteyeceği bilgiler.</p></div></div>
        <div class="market-form-grid">
          <label class="market-field market-wide"><span>İlan başlığı *</span><input name="title" required minlength="8" maxlength="100" placeholder="Örn. 22 ton paletli ekskavatör" /></label>
          <label class="market-field"><span>Marka</span><input name="brand" maxlength="60" placeholder="Marka" /></label>
          <label class="market-field"><span>Model</span><input name="model" maxlength="60" placeholder="Model" /></label>
          <label class="market-field"><span>Üretim yılı *</span><input name="year" type="number" required min="1950" max="2030" placeholder="2022" /></label>
          <label class="market-field"><span>Çalışma saati</span><input name="hours" type="number" min="0" max="1000000" placeholder="2500" /></label>
          <label class="market-field"><span>Şehir *</span><input name="location" required maxlength="60" placeholder="İstanbul" /></label>
          <label class="market-field"><span>Durum *</span><select name="condition" required><option value="">Seçiniz</option><option>Sıfır</option><option>İkinci el</option><option>Revizyonlu</option></select></label>
          <label class="market-field market-wide"><span>Açıklama *</span><textarea name="description" required minlength="20" maxlength="2000" rows="5" placeholder="Kullanım, bakım geçmişi, teslim ve varsa uyumluluk bilgileri..."></textarea></label>
        </div>
      </div>

      <div class="market-form-section">
        <div class="market-form-heading"><span>03</span><div><h2>Fiyat ve görsel.</h2><p>Gerçek yayında fotoğraflar satıcı tarafından yüklenir.</p></div></div>
        <div class="market-form-grid">
          <label class="market-field"><span>Fiyat *</span><input name="price" type="number" required min="1" step="1" placeholder="3500000" /></label>
          <label class="market-field"><span>Para birimi</span><select name="currency"><option value="₺">TRY · ₺</option><option value="€">EUR · €</option><option value="$">USD · $</option></select></label>
          <label class="market-field" id="rent-period-field" hidden><span>Kira dönemi</span><select name="rentPeriod"><option value="gün">Günlük</option><option value="hafta">Haftalık</option><option value="ay">Aylık</option></select></label>
          <label class="market-field market-wide"><span>Fotoğraflar (bu pilotta yüklenmez)</span><input name="photos" type="file" accept="image/*" multiple /><small>Seçilen dosyalar yalnızca kendi cihazında kalır; önizlemede dosya sayısı gösterilir.</small></label>
        </div>
      </div>

      <div class="market-form-actions">
        <button class="button primary" type="submit">İlan kartını önizle</button>
        <a href={href('/ilanlar/')}>Örnek ilanlara dön →</a>
      </div>
    </form>

    <aside class="market-preview-side">
      <div class="market-preview" id="market-preview" aria-live="polite">
        <span class="eyebrow">Canlı önizleme</span>
        <div class="market-preview-placeholder">İlan bilgilerini doldurup “İlan kartını önizle” düğmesine bas.</div>
        <div class="market-preview-result" hidden>
          <span class="market-demo-badge">DEMO · YAYINLANMADI</span>
          <span id="preview-offer" class="market-type"></span>
          <h2 id="preview-title"></h2>
          <p id="preview-meta"></p>
          <strong id="preview-price"></strong>
          <p id="preview-sectors"></p>
          <p id="preview-photos"></p>
          <p id="preview-description"></p>
        </div>
      </div>
      <p class="market-privacy-note">Bu aşamada hesap, ilan kaydı, fotoğraf yükleme ve satıcı iletişimi açık değildir. Önizleme yalnızca bu sayfada görünür.</p>
    </aside>
  </div></section>

  <script is:inline>
    const form = document.querySelector('#market-form');
    const periodField = document.querySelector('#rent-period-field');
    const sectors = [...form.querySelectorAll('input[name="sectors"]')];
    const error = document.querySelector('#sector-error');
    const labelMap = Object.fromEntries([...document.querySelectorAll('.market-sector-picker label')].map(label => [label.querySelector('input').value, label.querySelector('span').textContent]));
    function updateOffer() {
      periodField.hidden = form.elements.offer.value !== 'rent';
    }
    form.querySelectorAll('input[name="offer"]').forEach(input => input.addEventListener('change', updateOffer));
    sectors.forEach(input => input.addEventListener('change', () => { if (sectors.some(item => item.checked)) error.hidden = true; }));
    updateOffer();
    form.addEventListener('submit', event => {
      event.preventDefault();
      const checked = sectors.filter(input => input.checked).map(input => input.value);
      if (!checked.length) {
        error.hidden = false;
        sectors[0].focus();
        return;
      }
      error.hidden = true;
      const data = new FormData(form);
      const isRent = data.get('offer') === 'rent';
      const price = Number(data.get('price')).toLocaleString('tr-TR');
      const photos = form.elements.photos.files.length;
      document.querySelector('.market-preview-placeholder').hidden = true;
      document.querySelector('.market-preview-result').hidden = false;
      document.querySelector('#preview-offer').textContent = isRent ? 'Kiralık' : 'Satılık';
      document.querySelector('#preview-title').textContent = String(data.get('title'));
      document.querySelector('#preview-meta').textContent = [data.get('category'), data.get('brand'), data.get('model'), data.get('year'), data.get('location')].filter(Boolean).join(' · ');
      document.querySelector('#preview-price').textContent = String(data.get('currency')) + price + (isRent ? ' / ' + data.get('rentPeriod') : '');
      document.querySelector('#preview-sectors').textContent = 'Sektörler: ' + checked.map(value => labelMap[value]).join(', ');
      document.querySelector('#preview-photos').textContent = photos ? photos + ' fotoğraf seçildi (yüklenmedi)' : 'Fotoğraf seçilmedi';
      document.querySelector('#preview-description').textContent = String(data.get('description'));
      document.querySelector('#market-preview').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  </script>
</BaseLayout>
