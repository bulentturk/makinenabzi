---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sectors } from '../../data/platform';
import { demoListings } from '../../data/market-demo';
import '../../styles/market.css';

export function getStaticPaths() {
  return demoListings.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => base + path;
const sectorNames = Object.fromEntries(sectors.map((sector) => [sector.slug, sector.title]));
const related = demoListings.filter((other) =>
  other.slug !== item.slug && other.sectors.some((sector) => item.sectors.includes(sector))
).slice(0, 3);
---
<BaseLayout title={item.title + ' — Örnek İlan'} description={item.description} noindex={true}>
  <section class="market-detail-head">
    <div class="container">
      <nav class="market-crumb" aria-label="Konum"><a href={href('/')}>Ana sayfa</a><span>/</span><a href={href('/ilanlar/')}>Makine Pazarı</a><span>/</span><span>Örnek ilan</span></nav>
      <div class="market-detail-title">
        <div><span class="eyebrow">DEMO · GERÇEK İLAN DEĞİL</span><h1>{item.title}</h1><p>{item.location} · {item.category} · {item.condition}</p></div>
        <span class="market-type">{item.offer === 'sale' ? 'Satılık' : 'Kiralık'}</span>
      </div>
    </div>
  </section>

  <section class="section market-section">
    <div class="container market-detail-layout">
      <div class="market-detail-main">
        <div class="market-detail-photo">
          <img src={href(item.image)} alt="Temsili sektör görseli; örnek ilandaki ekipmana ait değildir" />
          <span>Temsili sektör görseli · Makine fotoğrafı değildir</span>
        </div>
        <div class="market-panel">
          <span class="eyebrow">Açıklama</span>
          <h2>Ekipman hakkında</h2>
          <p>{item.description}</p>
          <p>Gerçek ilanlarda satıcının yüklediği fotoğraflar, ayrıntılı kondisyon ve servis kayıtları burada gösterilecek.</p>
        </div>
        <div class="market-panel">
          <span class="eyebrow">Teknik özet</span>
          <h2>Öne çıkan bilgiler</h2>
          <ul class="market-details-list">{item.details.map((detail) => <li>{detail}</li>)}</ul>
        </div>
      </div>
      <aside class="market-detail-side">
        <div class="market-price-panel">
          <span>{item.offer === 'sale' ? 'Örnek satış fiyatı' : 'Örnek kira bedeli'}</span>
          <strong>{item.price}</strong>
          <p>Bu fiyat temsili olup teklif oluşturmaz.</p>
          <div class="market-price-divider"></div>
          <dl>
            <div><dt>Marka</dt><dd>{item.brand}</dd></div>
            <div><dt>Model</dt><dd>{item.model}</dd></div>
            <div><dt>Yıl</dt><dd>{item.year}</dd></div>
            <div><dt>Çalışma</dt><dd>{item.hours === null ? 'Belirtilmedi' : item.hours.toLocaleString('tr-TR') + ' saat'}</dd></div>
            <div><dt>Konum</dt><dd>{item.location}</dd></div>
          </dl>
          <div class="market-price-divider"></div>
          <p class="market-side-label">İlgili sektörler</p>
          <div class="market-sector-tags">{item.sectors.map((sector) => <a href={href('/ilanlar/?sektor=' + sector)}>{sectorNames[sector]}</a>)}</div>
          <div class="market-demo-action">Pilot aşamasında iletişim ve satın alma kapalıdır.</div>
          <a class="button ghost market-back-button" href={href('/ilanlar/')}>Tüm örnek ilanlar →</a>
        </div>
      </aside>
    </div>
    {related.length > 0 && <div class="container market-related">
      <div class="market-section-head"><div><span class="eyebrow">Keşfet</span><h2>Benzer örnekler.</h2></div></div>
      <div class="market-related-grid">{related.map((other) =>
        <a href={href('/ilanlar/' + other.slug + '/')}><span>{other.offer === 'sale' ? 'Satılık' : 'Kiralık'}</span><strong>{other.title}</strong><small>{other.location} · {other.price}</small></a>
      )}</div>
    </div>}
  </section>
</BaseLayout>
