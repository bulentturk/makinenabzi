---
import BaseLayout from '../layouts/BaseLayout.astro';
const events=[['Küresel','Bauma — Münih','İş makinaları ve madencilik teknolojileri'],['Küresel','CONEXPO-CON/AGG — Las Vegas','İnşaat ve ağır ekipman'],['Küresel','MINExpo — Las Vegas','Madencilik ekipmanları ve teknoloji'],['Küresel','Agritechnica — Hannover','Tarım makinaları ve tarım teknolojileri'],['Teknoloji','iVT Expo Europe / USA','Off-highway elektrifikasyon, otonomi ve hidrolik'],['Türkiye','KOMATEK / ANKOMAK','İş ve inşaat makinaları'],['Türkiye','Mining Turkey','Maden teknolojileri ve ekipman'],['Türkiye','WIN EURASIA','Endüstriyel teknoloji ve bileşenler'],['Türkiye','Growtech','Tarım teknolojileri']];
---
<BaseLayout title="Fuar Takvimi"><section class="page-head"><div class="container"><span class="eyebrow">Takvim & ekosistem</span><h1>Fuar Takvimi</h1><p>Sektörün önemli küresel ve Türkiye buluşmaları. Tarihler yayına alınmadan önce resmi etkinlik sayfasından ayrıca doğrulanacaktır.</p></div></section><section class="section"><div class="container"><div class="timeline">{events.map(([scope,event,desc]) => <div class="timeline-row"><div class="place">{scope}</div><div><h3>{event}</h3><p>{desc}</p></div></div>)}</div></div></section></BaseLayout>
