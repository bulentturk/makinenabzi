---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalog from '../../agent/source-catalog.json';

const groups: [string, string[]][] = [
  ['Off-highway & genel', ['iVT International','OEM Off-Highway','Power & Motion','KHL Group','SAE Truck & Off-Highway Engineering','Equipment World','Construction Briefing']],
  ['Motor & güç aktarma', ['Powertrain International Off-Highway','Power Progress Off-Highway','DEUTZ Press Releases','Cummins Press Releases','Perkins Press Releases','Volvo Penta News','ZF Press','Allison Transmission Newsroom','Dana Press Releases','Kessler + Co Press','Carraro News','Power Transmission Engineering','Gear Technology','Green Car Congress']],
  ['Paletli yürüyüş & alt takım', ['Berco News','ITM Group']],
  ['Bileşen & hidrolik', ['Hydraulics & Pneumatics','Fluid Power World','Fluid Power Journal','NFPA','Teknikport']],
  ['Madencilik', ['Normet','Epiroc','Sandvik Mining','Getman','Hencon','International Mining','Mining Magazine','Global Mining Review','MINING.COM','E&MJ','Madencilik Türkiye','Türkiye Madenciler Derneği','Yeraltı Haber','YMGV','MAPEG']],
  ['Liman & malzeme elleçleme', ['TÜRKLİM','Port Technology International','Port Strategy','HANSA','Container News','International Cranes & Specialized Transport','FEM','IAPH']],
  ['Tarım', ['TARMAKBİR','TARMAKDER','TürkTraktör','Farm Equipment','profi','Future Farming','AgFunderNews','Farm Progress','Farmers Weekly','CEMA']],
  ['Araç üstü ekipman & kaldırma', ['ARÜSDER','PLATFORMDER','LHT','Vinç & Platform','Boom Makina']],
  ['Havalimanı & GSE', ['DENGE GSE','DHMİ','SHGM','Passenger Terminal Today','Airport Suppliers','Aviation24 Ground Handling','Aviation Pros Ground Support Worldwide','Airport Industry-News Ground Support','Ground Handling International','GSE Expo Europe']],
  ['Marine & yatçılık', ['YATED','GİSBİR','Türk Loydu','Motoryat','Marine Industry News','Marine Industry News Electric Boats','The Maritime Executive','Marine Insight','Powertrain International Marine','METSTRADE','IBEX']],
  ['Elektrifikasyon & batarya', ['electrive','Charged EVs','Battery Technology','Energy-Storage.news']],
  ['İş Makinaları OEM basın odaları', ['HİDROMEK','Caterpillar Newsroom','Komatsu News','Volvo CE News','Liebherr Press','Wacker Neuson News','JCB News','Manitou News','Hitachi CM News']],
  ['Türkiye iş makinaları & sanayi', ['İMDER','İSDER','İMMB','İŞİM Kümelenmesi','Forum Makina','Makina Market','MAKFED','TAYSAD','Anadolu Isuzu','Sanayi Gazetesi']]
];
const byName = new Map(catalog.map(source => [source.name,source]));
const eventSources: Record<string,string> = {
  'METSTRADE':'https://www.metstrade.com/',
  'IBEX':'https://www.ibexshow.com/'
};
const description = (name:string) => {
  const source = byName.get(name);
  if (source?.status?.startsWith('active-rss')) return 'RSS ile otomatik taranıyor; yayın öncesi editoryal onay gerekir';
  if (source?.kind === 'manufacturer_pressroom') return 'Üretici açıklaması; teknik iddialar ayrıca doğrulanır';
  if (source?.kind === 'event_source' || eventSources[name]) return 'Resmi etkinlik kaynağı';
  return 'Editoryal kaynak / izleme listesi';
};
---
<BaseLayout title="Kaynaklar" description="Makine Nabzı için off-highway, motor ve güç aktarma, GSE, marine, liman, tarım ve madencilik kaynakları.">
  <section class="page-head"><div class="container">
    <span class="eyebrow">Medya, üretici & kuruluşlar</span><h1>Kaynaklar</h1>
    <p>Teknik basın, üretici duyuruları ve resmi etkinlikler birlikte izlenir. RSS ile taranan yazılar otomatik yayımlanmaz; her haber kaynak kontrolü ve insan onayı bekler.</p>
  </div></section>
  <section class="section"><div class="container">
    {groups.map(([group,items]) => <section class="resource-group">
      <h2>{group}</h2>
      <div class="resource-list">{items.map(name => {
        const url = byName.get(name)?.url || eventSources[name];
        return url ? <a class="resource" href={url} target="_blank" rel="noopener noreferrer"><strong>{name} ↗</strong><span>{description(name)}</span></a>
          : <div class="resource"><strong>{name}</strong><span>{description(name)}</span></div>;
      })}</div>
    </section>)}
  </div></section>
</BaseLayout>
