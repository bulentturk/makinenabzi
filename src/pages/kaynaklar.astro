---
import BaseLayout from '../layouts/BaseLayout.astro';
const groups=[['Off-highway & genel',['iVT Off-Highway / iVT International','KHL Group','Diesel Progress / Diesel & Gas Turbine','SAE Truck & Off-Highway Engineering']],['Bileşen & güç aktarma',['Hydraulics & Pneumatics','Power Transmission Engineering','Gear Technology','NFPA']],['Madencilik',['Engineering & Mining Journal (E&MJ)','International Mining','Mining Magazine','Global Mining Review','ICMM']],['Liman & malzeme elleçleme',['Port Technology International','Port Strategy','HANSA','International Cranes & Specialized Transport','FEM','IAPH']],['Tarım',['Farm Equipment','profi / Landtechnik / agrartechnik','Farmers Weekly','CEMA','TARMAKBİR']],['Türkiye kurumları',['MAİB','MAKFED','İMDER','İSDER','AKDER','MAPEG','TMMOB meslek odaları']]];
---
<BaseLayout title="Kaynaklar"><section class="page-head"><div class="container"><span class="eyebrow">Medya & kuruluşlar</span><h1>Kaynaklar</h1><p>İçerik araştırmalarında kullanılacak ana referans havuzu. İlerleyen sürümde konu, sektör ve ülkeye göre filtrelenebilir hale gelecek.</p></div></section><section class="section"><div class="container">{groups.map(([group,items]) => <section class="resource-group"><h2>{group}</h2><div class="resource-list">{(items as string[]).map(item => <div class="resource">{item}<span>Araştırma ve doğrulama kaynağı</span></div>)}</div></section>)}</div></section></BaseLayout>
