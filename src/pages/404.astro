---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Sayfa bulunamadı"
  description="Aradığınız sayfa bulunamadı. Makine Nabzı haberlerine, teknik merkeze ve fuar takvimine devam edebilirsiniz."
  noindex
>
  <section class="page-head"><div class="container">
    <span class="eyebrow">404</span>
    <h1>Sayfa bulunamadı</h1>
    <p>Aradığınız sayfa taşınmış, kaldırılmış ya da adresi yanlış yazılmış olabilir. Aşağıdan devam edebilirsiniz.</p>
    <div class="hero-actions">
      <a class="button primary" href="/">Ana sayfaya dön</a>
      <a class="button ghost glass" href="/haberler/">Son haberlere git</a>
      <a class="button ghost glass" href="/fuar-takvimi/">Fuar takvimi</a>
    </div>
  </div></section>

  <script is:inline>
    // Uygulama /app/ altında yaşıyor. Statik sunucuda /app/auth gibi yollar
    // 404'e düşerse sonuna slash ekleyerek hazır index.html'e çevir.
    if (location.pathname.startsWith('/app/')) {
      const rest = location.pathname.slice(5);
      if (rest && !rest.endsWith('/')) {
        location.replace('/app/' + rest + '/' + location.search + location.hash);
      }
    }
  </script>
</BaseLayout>
