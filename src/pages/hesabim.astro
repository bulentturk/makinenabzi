---
import BaseLayout from '../layouts/BaseLayout.astro';
import HesabimPanel from '../components/member/HesabimPanel';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;

// Convex dağıtım adresi gizli değil; ortam değişkeni yoksa geliştirme
// dağıtımı kullanılır.
const convexUrl =
  import.meta.env.PUBLIC_CONVEX_URL ?? 'https://flexible-ibex-197.eu-west-1.convex.cloud';
---

<BaseLayout
  title="Hesabım"
  description="Makine Nabzı üye paneli: ilanlarınızı yönetin, yeni ilan verin, onay durumlarını görün."
  noindex
>
  <section class="page-head"><div class="container">
    <span class="eyebrow">Üyelik</span>
    <h1>Hesabım</h1>
    <p>İlanlarınızı yönetin, yeni ilan verin; editörseniz onay kuyruğunu buradan işleyin.</p>
  </div></section>

  <section class="section member-section"><div class="container">
    <HesabimPanel client:only="react" convexUrl={convexUrl} />

    <p class="member-fine member-footnote">
      İlanlarınız aynı hesap üzerinden Android uygulamasında da görünür.
      Sorularınız için <a href={href('/iletisim/')}>iletişim sayfasını</a> kullanabilirsiniz.
    </p>
  </div></section>
</BaseLayout>
