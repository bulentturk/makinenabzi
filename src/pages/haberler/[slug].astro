---
import BaseLayout from '../../layouts/BaseLayout.astro';
import news from '../../data/published-news.json';

export function getStaticPaths() {
  return news.map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

const { item } = Astro.props;
const sectorLabels = {
  'is-makinalari':'İş Makinaları',
  'madencilik':'Madencilik',
  'liman':'Liman & Elleçleme',
  'tarim':'Tarım Makinaları',
  'arac-ustu-ekipman':'Araç Üstü Ekipman',
  'havaalani-gse':'Havalimanı & GSE',
  'marine-yatcilik':'Marine & Yatçılık',
  'elektrifikasyon':'Elektrifikasyon'
};
const techLabels = {
  'elektrifikasyon':'Elektrifikasyon',
  'hidrolik':'Hidrolik',
  'yuruyus-guc-aktarma':'Yürüyüş & Güç Aktarma',
  'elektronik-telematik':'Elektronik & Telematik',
  'otonomi-ai':'Otonomi & AI',
  'emisyon-stage-v':'Emisyon & Stage V',
  'fonksiyonel-guvenlik':'Fonksiyonel Güvenlik',
  'termal-yonetim':'Termal Yönetim'
};
const dateFormat = new Intl.DateTimeFormat('tr-TR',{day:'numeric',month:'long',year:'numeric'});
const sourceDate = dateFormat.format(new Date(item.source_published_at));
const siteDate = dateFormat.format(new Date(item.site_published_at));
const updatedDate = item.site_updated_at ? dateFormat.format(new Date(item.site_updated_at)) : '';
const paragraphs = String(item.summary || '').split(/\n\s*\n/).filter(Boolean);
const { enrichments } = await import('../../data/article-enrichments');
const { guides } = await import('../../data/technical-guides');
const { formatPieces } = await import('../../data/formats');
const enrichment = enrichments.find((e) => e.slug === item.slug);
const enrichmentGuides = guides.filter((g) => (enrichment?.relatedGuides || []).includes(g.slug));
const enrichmentFormats = formatPieces.filter((p) => (enrichment?.relatedFormats || []).includes(p.slug));
const wordCount = String(item.summary || '').split(/\s+/).filter(Boolean).length + String(item.why_it_matters || '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const related = news
  .filter((other) => other.slug !== item.slug)
  .map((other) => ({
    other,
    score:
      (other.sector === item.sector ? 2 : 0) +
      (other.technologies || []).filter((t) => (item.technologies || []).includes(t)).length +
      (other.tags || []).filter((t) => (item.tags || []).includes(t)).length * 0.5
  }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score || Date.parse(b.other.site_published_at) - Date.parse(a.other.site_published_at))
  .slice(0, 3)
  .map((r) => r.other);
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const dateModified = item.site_updated_at || item.site_published_at;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: item.title,
  description: item.dek,
  datePublished: item.site_published_at,
  dateModified,
  inLanguage: 'tr-TR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  articleSection: sectorLabels[item.sector] || item.sector,
  keywords: (item.tags || []).join(', '),
  ...(item.hero_image ? { image: [item.hero_image] } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Makine Nabzı',
    url: 'https://makinenabzi.com/',
    logo: { '@type': 'ImageObject', url: 'https://makinenabzi.com/brand-mark.svg' }
  }
};
---
<BaseLayout
  title={item.title}
  description={item.dek}
  type="article"
  publishedTime={item.site_published_at}
  modifiedTime={dateModified}
  image={item.hero_image}
  jsonLd={jsonLd}
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-narrow">
        <div class="article-meta">
          <span class="tag">{sectorLabels[item.sector] || item.sector}</span>
          {'format' in item && item.format === 'gorus-analiz' && <span class="tag">Görüş / Analiz</span>}
          {item.technologies?.map((t) => <span class="tag">{techLabels[t] || t}</span>)}
          <time datetime={item.site_published_at}>Yayın: {siteDate}</time>
          <time datetime={item.source_published_at}>Kaynak: {sourceDate}</time>
          {updatedDate && <time datetime={item.site_updated_at}>Güncelleme: {updatedDate}</time>}
          <span class="tag">{readingMinutes} dk okuma</span>
        </div>
        <h1>{item.title}</h1>
        <p class="article-dek">{item.dek}</p>
        {item.update_note && <p class="article-update-note">Güncelleme notu: {item.update_note}</p>}
        {item.hero_image ? <img class="article-hero-image" src={item.hero_image} alt="" /> : null}
      </div>
    </header>

    <div class="container article-layout">
      <div class="article-body">
        {paragraphs.map((p) => <p>{p}</p>)}

        {item.key_facts?.length ? (
          <section class="article-facts">
            <h2>Öne çıkan bilgiler</h2>
            <ul>{item.key_facts.map((fact) => <li>{fact}</li>)}</ul>
          </section>
        ) : null}

        {enrichment && (
          <section class="article-analysis">
            <span class="eyebrow">Makine Nabzı</span>
            <h2>{enrichment.headline}</h2>
            {enrichment.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        )}

        {item.why_it_matters ? (
          <section class="article-analysis">
            <span class="eyebrow">Makine Nabzı yorumu</span>
            <h2>Neden önemli?</h2>
            <p>{item.why_it_matters}</p>
          </section>
        ) : null}

        {(enrichmentGuides.length > 0 || enrichmentFormats.length > 0) && (
          <section class="article-source">
            <h2>Derinlemesine okuyun</h2>
            <ul>
              {enrichmentGuides.map((g) => <li><a href={`/teknik-blog/${g.slug}/`}>Teknik dosya: {g.title} →</a></li>)}
              {enrichmentFormats.map((p) => <li><a href={`/formatlar/${p.slug}/`}>{p.format}: {p.title} →</a></li>)}
            </ul>
          </section>
        )}

        <section class="article-source">
          <h2>Kaynak</h2>
          <p>{item.source_name}</p>
          <a href={item.source_url} target="_blank" rel="noopener noreferrer">Orijinal kaynağı aç →</a>
        </section>

        {related.length ? (
          <section class="article-related">
            <h2>İlgili haberler</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={`/haberler/${r.slug}/`}>{r.title}</a>
                  <span>{sectorLabels[r.sector] || r.sector}</span>
                </li>
              ))}
            </ul>
          </section>
        ) : null}
      </div>
    </div>
  </article>
</BaseLayout>
