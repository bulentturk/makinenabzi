---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guides } from '../data/technical-guides';
const items=[
  ['Yürüyüş & Güç Aktarma','Şanzıman, torque converter, powershift ve hidrostatik tahrik; aks, diferansiyel, final drive, planet redüktör, palet-lastik yürüyüş elemanları, aşınma ve yağlama.'],
  ['Elektrifikasyon & Elektrikli Tahrik','Elektrik motoru, inverter, batarya, BMS, HV mimari ve termal yönetim.'],
  ['Hidrolik Sistemler','Pompa ve motor verimliliği, valfler, enerji kayıpları, gürültü ve kestirimci bakım.'],
  ['Elektronik & Telematik','VCU, HMI, CAN/J1939, CANopen, sensörler, telemetri ve uzaktan servis.'],
  ['Termal Yönetim','Motor, şanzıman, hidrolik, inverter ve batarya soğutma; saha arıza belirtileri.'],
  ['Otonomi & Sistem Entegrasyonu','Makine görüşü, sensör füzyonu, operatör destek sistemleri, güvenli kontrol ve otonomiye geçiş.']
];
---
<BaseLayout title="Teknik Merkez" description="Hidrolik, güç aktarma, elektrifikasyon, CAN/J1939 telematik, termal yönetim ve otonomi: mobil makineleri sistem seviyesinde anlatan mühendislik odaklı teknik dosyalar.">
  <section class="page-head"><div class="container">
    <span class="eyebrow">Mühendislik derinliği</span>
    <h1>Teknik Merkez</h1>
    <p>Mobil makineleri sistem seviyesinde ele alan teknik dosyalar. Konular, makinenin gerçek mimarisine göre ana sistem ve alt sistem ilişkisiyle sınıflandırılır.</p>
  </div></section>
  <section class="section"><div class="container"><div class="grid-3">
    {items.map(([title,desc],i) => <article class="card"><span class="tag">Sistem {String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{desc}</p></article>)}
  </div></div></section>
  <section class="section"><div class="container">
    <h2>Yayınlanan teknik dosyalar</h2>
    <div class="guide-list">
      {guides.map((guide) => (
        <a class="guide-link" href={`/teknik-blog/${guide.slug}/`}>
          <b>{guide.title}</b>
          <span>{guide.system}</span>
        </a>
      ))}
    </div>
  </div></section>
</BaseLayout>
