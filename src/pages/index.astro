---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sectors, technologies, editorialFormats } from '../data/platform';
import news from '../data/published-news.json';
import { events } from '../data/events';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p:string) => `${base}${p}`;
const dateFormat = new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' });
const sectorLabels: Record<string, string> = {
  'is-makinalari': 'İş Makinaları',
  madencilik: 'Madencilik',
  liman: 'Liman & Elleçleme',
  tarim: 'Tarım Makinaları',
  'arac-ustu-ekipman': 'Araç Üstü Ekipman',
  'havaalani-gse': 'Havalimanı & GSE',
  'marine-yatcilik': 'Marine & Yatçılık',
  elektrifikasyon: 'Elektrifikasyon'
};
const latestNews = [...news]
  .sort((a, b) => Date.parse(b.site_published_at || b.source_published_at) - Date.parse(a.site_published_at || a.source_published_at))
  .slice(0, 3);
const nextEvents = [...events]
  .filter((event) => Date.parse(`${event.end || event.start}T23:59:59Z`) >= Date.now())
  .sort((a, b) => Date.parse(a.start) - Date.parse(b.start))
  .slice(0, 2);

const highlights = [
  {
    label: 'Teknoloji Radar',
    title: 'Elektrifikasyon artık sadece prototip konusu değil',
    text: 'Batarya, e-motor, inverter ve termal yönetim; mobil makinelerde ürün mimarisini yeniden şekillendiriyor.'
  },
  {
    label: 'Teknik Merkez',
    title: 'Makinenin içindeki sistemi anlayın',
    text: 'Hidrolikten güç aktarmaya, CAN/J1939’dan emisyon sistemlerine kadar mühendislik odaklı içerikler.'
  },
  {
    label: 'Sektör Nabzı',
    title: 'OEM, fuar, yatırım ve saha gelişmeleri',
    text: 'Güncel gelişmeleri yalnız haber olarak değil, teknik ve sektörel bağlamıyla takip edin.'
  }
];
---
<BaseLayout>
  <section class="hero hero-v2">
    <div class="hero-media">
      <img src="https://images.unsplash.com/photo-1764422743505-97c9ea0e43f2?auto=format&fit=crop&w=2200&q=86" alt="Ağır iş makinası" />
      <div class="hero-shade"></div>
    </div>
    <div class="container hero-v2-content">
      <span class="eyebrow">Mobil Makine Teknolojileri Platformu</span>
      <h1>Makinenin kendisinden <span>onu mümkün kılan teknolojiye.</span></h1>
      <p class="lead">İş makinaları, madencilik, liman, tarım, araç üstü ekipman, havalimanı GSE ve marine teknolojilerinde; motor, güç aktarma ve elektrifikasyon gelişmelerini teknik bağlamıyla takip ediyoruz.</p>
      <div class="hero-actions">
        <a class="button primary" href="#son-haberler">Son haberleri oku</a>
        <a class="button ghost glass" href="#sektorler">Sektörleri keşfet</a>
      </div>
      <div class="hero-stats">
        <div><strong>{sectors.length}</strong><span>Ana sektör</span></div>
        <div><strong>{technologies.length}</strong><span>Teknoloji alanı</span></div>
        <div><strong>{editorialFormats.length}</strong><span>İçerik formatı</span></div>
      </div>
    </div>
  </section>

  {latestNews.length > 0 && (
    <section class="section home-pulse" id="son-haberler">
      <div class="container">
        <div class="section-head">
          <div>
            <span class="eyebrow">Gündem</span>
            <h2>Sektörün nabzı.</h2>
          </div>
          <a class="link-arrow" href={href('/haberler/')}>Tüm haberler →</a>
        </div>
        <div class="home-pulse-layout">
          <div class="pulse-news-grid">
            {latestNews.map((item, index) => (
              <a class:list={['pulse-story', index === 0 && 'pulse-story-lead']} href={href(`/haberler/${item.slug}/`)}>
                <div class="pulse-story-meta">
                  <span class="tag">{sectorLabels[item.sector] || item.sector}</span>
                  {'format' in item && item.format === 'gorus-analiz' && <span class="tag">Görüş / Analiz</span>}
                  <time datetime={item.site_published_at || item.source_published_at}>
                    Yayın: {dateFormat.format(new Date(item.site_published_at || item.source_published_at))}
                  </time>
                </div>
                <h3>{item.title}</h3>
                <p>{item.dek}</p>
                <span class="pulse-story-bottom"><small>Kaynak: {item.source_name}</small><strong>{'format' in item && item.format === 'gorus-analiz' ? 'Yazıyı oku →' : 'Haberi oku →'}</strong></span>
              </a>
            ))}
          </div>
          {nextEvents.length > 0 && (
            <aside class="home-events" aria-label="Yaklaşan fuarlar">
              <div class="home-events-head">
                <span class="eyebrow">Fuar radarı</span>
                <h3>Yaklaşan buluşmalar</h3>
              </div>
              {nextEvents.map((event) => (
                <div class="home-event">
                  <span>{event.sector}</span>
                  <h4>{event.name}</h4>
                  <time datetime={event.start}>
                    {('date_label' in event && event.date_label)
                      ? event.date_label
                      : (event.end ? `${dateFormat.format(new Date(event.start))} – ${dateFormat.format(new Date(event.end))}` : dateFormat.format(new Date(event.start)))}
                  </time>
                  <small>{event.city} · {event.country}</small>
                </div>
              ))}
              <a href={href('/fuar-takvimi/')}>Fuar takviminin tamamı →</a>
            </aside>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section section-intro">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Makine Nabzı yaklaşımı</span>
          <h2>Haber sitesi değil, sektörün teknik referans noktası.</h2>
        </div>
        <p>Makineyi sadece marka ve model olarak değil; hidrolik, güç aktarma, elektronik, telemetri, elektrifikasyon, emisyon ve güvenlik sistemleriyle birlikte ele alıyoruz.</p>
      </div>
      <div class="highlight-grid">
        {highlights.map(item => <article class="highlight-card"><span>{item.label}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="sektorler">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Sektörler</span><h2>Makinenin çalıştığı her saha.</h2></div>
        <p>Şantiyeden madene, limandan aprona ve denize; makineleri ortak motor, yürüyüş grubu, kontrol ve enerji teknolojileriyle birlikte ele alıyoruz.</p>
      </div>
      <div class="sector-grid">
        {sectors.map((sector, i) => (
          <article class:list={['sector-card', i === 0 && 'sector-card-featured']}>
            <img src={sector.image.startsWith('http') ? sector.image : href(sector.image)} alt={sector.title} loading={i === 0 ? 'eager' : 'lazy'} />
            <div class="sector-overlay"></div>
            <div class="sector-content">
              <span>{sector.kicker}</span>
              <h3>{sector.title}</h3>
              <p>{sector.description}</p>
              <a href={href(`/haberler/?sektor=${sector.slug}`)}>İçerikleri gör →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="teknoloji">
    <div class="container technology-layout">
      <div class="technology-intro">
        <span class="eyebrow">Teknoloji Haritası</span>
        <h2>Mobil makinelerin dönüşümünü sistem seviyesinde takip edin.</h2>
        <p>Yeni ürünlerin ardındaki teknolojiyi görün. Bir batarya paketinden bir CAN mesajına, bir powershift şanzımandan güvenli kontrol mimarisine kadar.</p>
        <a class="button ghost" href={href('/teknik-blog/')}>Teknik Merkeze git</a>
      </div>
      <div class="technology-grid">
        {technologies.map(([title, description], i) => (
          <article class="tech-card">
            <span>{String(i+1).padStart(2,'0')}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Editoryal yapı</span><h2>Tek format değil, gerçek bir bilgi platformu.</h2></div>
        <p>Her içerik aynı amaca hizmet etmiyor. Güncel haber hızlı bilgi verirken teknik inceleme, karşılaştırma ve saha rehberi karar vermeyi kolaylaştırır.</p>
      </div>
      <div class="format-grid">
        {editorialFormats.map(([title, description]) => (
          <article class="format-card"><h3>{title}</h3><p>{description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-feature">
      <div class="split-image">
        <img src="https://images.unsplash.com/photo-1786209273552-3b57dec47c94?auto=format&fit=crop&w=1600&q=82" alt="Madencilik makinası" loading="lazy" />
      </div>
      <div class="split-copy">
        <span class="eyebrow">Özel Dosya</span>
        <h2>Elektrifikasyon & Retrofit Merkezi</h2>
        <p>Dizel makinelerin elektrikliye dönüşümünden batarya boyutlandırmaya, inverter seçiminden termal yönetime kadar mobil makine elektrifikasyonunu ayrı bir uzmanlık alanı olarak ele alacağız.</p>
        <ul class="clean-list">
          <li>Batarya & BMS mimarileri</li>
          <li>E-motor ve inverter seçimi</li>
          <li>Şarj altyapısı ve HV güvenliği</li>
          <li>Retrofit vaka çalışmaları</li>
          <li>Hibrit ve tam elektrikli mimari karşılaştırmaları</li>
        </ul>
        <a class="button primary" href={href('/teknik-blog/')}>Dosyaları keşfet</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Yakında</span><h2>Makine Nabzı sadece web sitesi olarak kalmayacak.</h2></div>
        <p>İçerik modeli baştan mobil uygulamaya uygun kuruluyor. Favoriler, kişiselleştirilmiş akış, bildirimler, takip edilen sektörler ve kayıtlı teknik dosyalar sonraki ürün katmanları.</p>
      </div>
    </div>
  </section>
</BaseLayout>
