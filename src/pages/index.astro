---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sectors, technologies, editorialFormats } from '../data/platform';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p:string) => `${base}${p}`;

const highlights = [
  {
    label: 'Teknoloji Radar',
    title: 'Elektrifikasyon artık sadece prototip konusu değil',
    text: 'Batarya, e-motor, inverter ve termal yönetim; mobil makinelerde ürün mimarisini yeniden şekillendiriyor.'
  },
  {
    label: 'Teknik Merkez',
    title: 'Makinenin içindeki sistemi anlayın',
    text: 'Hidrolikten güç aktarmaya, CAN/J1939’dan emisyon sistemlerine kadar mühendislik odaklı içerikler.'
  },
  {
    label: 'Sektör Nabzı',
    title: 'OEM, fuar, yatırım ve saha gelişmeleri',
    text: 'Güncel gelişmeleri yalnız haber olarak değil, teknik ve sektörel bağlamıyla takip edin.'
  }
];
---
<BaseLayout>
  <section class="hero hero-v2">
    <div class="hero-media">
      <img src="https://images.unsplash.com/photo-1764422743505-97c9ea0e43f2?auto=format&fit=crop&w=2200&q=86" alt="Ağır iş makinası" />
      <div class="hero-shade"></div>
    </div>
    <div class="container hero-v2-content">
      <span class="eyebrow">Mobil Makine Teknolojileri Platformu</span>
      <h1>Makinenin kendisinden <span>onu mümkün kılan teknolojiye.</span></h1>
      <p class="lead">İş makinaları, madencilik, liman ekipmanları, tarım makinaları, araç üstü ekipmanlar ve elektrifikasyonda güncel haber, teknik analiz, saha bilgisi ve teknoloji radarını tek yerde buluşturuyoruz.</p>
      <div class="hero-actions">
        <a class="button primary" href="#sektorler">Sektörleri keşfet</a>
        <a class="button ghost glass" href={href('/teknik-blog/')}>Teknik Merkez</a>
      </div>
      <div class="hero-stats">
        <div><strong>6</strong><span>Ana sektör</span></div>
        <div><strong>8</strong><span>Teknoloji alanı</span></div>
        <div><strong>8</strong><span>İçerik formatı</span></div>
      </div>
    </div>
  </section>

  <section class="section section-intro">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Makine Nabzı yaklaşımı</span>
          <h2>Haber sitesi değil, sektörün teknik referans noktası.</h2>
        </div>
        <p>Makineyi sadece marka ve model olarak değil; hidrolik, güç aktarma, elektronik, telemetri, elektrifikasyon, emisyon ve güvenlik sistemleriyle birlikte ele alıyoruz.</p>
      </div>
      <div class="highlight-grid">
        {highlights.map(item => <article class="highlight-card"><span>{item.label}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="sektorler">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Sektörler</span><h2>Makinenin çalıştığı her saha.</h2></div>
        <p>İnşaattan yeraltına, limandan tarlaya; farklı sektörleri aynı teknik dil altında birleştiren içerik omurgası.</p>
      </div>
      <div class="sector-grid">
        {sectors.map((sector, i) => (
          <article class:list={['sector-card', i === 0 && 'sector-card-featured']}>
            <img src={sector.image} alt={sector.title} loading={i === 0 ? 'eager' : 'lazy'} />
            <div class="sector-overlay"></div>
            <div class="sector-content">
              <span>{sector.kicker}</span>
              <h3>{sector.title}</h3>
              <p>{sector.description}</p>
              <a href={href('/haberler/')}>İçerikleri gör →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="teknoloji">
    <div class="container technology-layout">
      <div class="technology-intro">
        <span class="eyebrow">Teknoloji Haritası</span>
        <h2>Mobil makinelerin dönüşümünü sistem seviyesinde takip edin.</h2>
        <p>Yeni ürünlerin ardındaki teknolojiyi görün. Bir batarya paketinden bir CAN mesajına, bir powershift şanzımandan güvenli kontrol mimarisine kadar.</p>
        <a class="button ghost" href={href('/teknik-blog/')}>Teknik Merkeze git</a>
      </div>
      <div class="technology-grid">
        {technologies.map(([title, description], i) => (
          <article class="tech-card">
            <span>{String(i+1).padStart(2,'0')}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Editoryal yapı</span><h2>Tek format değil, gerçek bir bilgi platformu.</h2></div>
        <p>Her içerik aynı amaca hizmet etmiyor. Güncel haber hızlı bilgi verirken teknik inceleme, karşılaştırma ve saha rehberi karar vermeyi kolaylaştırır.</p>
      </div>
      <div class="format-grid">
        {editorialFormats.map(([title, description]) => (
          <article class="format-card"><h3>{title}</h3><p>{description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-feature">
      <div class="split-image">
        <img src="https://images.unsplash.com/photo-1786209273552-3b57dec47c94?auto=format&fit=crop&w=1600&q=82" alt="Madencilik makinası" loading="lazy" />
      </div>
      <div class="split-copy">
        <span class="eyebrow">Özel Dosya</span>
        <h2>Elektrifikasyon & Retrofit Merkezi</h2>
        <p>Dizel makinelerin elektrikliye dönüşümünden batarya boyutlandırmaya, inverter seçiminden termal yönetime kadar mobil makine elektrifikasyonunu ayrı bir uzmanlık alanı olarak ele alacağız.</p>
        <ul class="clean-list">
          <li>Batarya & BMS mimarileri</li>
          <li>E-motor ve inverter seçimi</li>
          <li>Şarj altyapısı ve HV güvenliği</li>
          <li>Retrofit vaka çalışmaları</li>
          <li>Hibrit ve tam elektrikli mimari karşılaştırmaları</li>
        </ul>
        <a class="button primary" href={href('/teknik-blog/')}>Dosyaları keşfet</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Yakında</span><h2>Makine Nabzı sadece web sitesi olarak kalmayacak.</h2></div>
        <p>İçerik modeli baştan mobil uygulamaya uygun kuruluyor. Favoriler, kişiselleştirilmiş akış, bildirimler, takip edilen sektörler ve kayıtlı teknik dosyalar sonraki ürün katmanları.</p>
      </div>
    </div>
  </section>
</BaseLayout>