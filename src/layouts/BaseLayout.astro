---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Makine Nabzı',
  description = 'İş makinaları, madencilik, liman, tarım, araç üstü ekipman ve elektrifikasyonda haber, teknik analiz ve teknoloji platformu.'
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['Sektörler', '/#sektorler'],
  ['Teknoloji', '/#teknoloji'],
  ['Haberler', '/haberler/'],
  ['Teknik Merkez', '/teknik-blog/'],
  ['Fuarlar', '/fuar-takvimi/'],
  ['Kaynaklar', '/kaynaklar/'],
];
const href = (path:string) => path.startsWith('#') ? path : `${base}${path}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#081018" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <title>{title === 'Makine Nabzı' ? title : `${title} | Makine Nabzı`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand" href={href('/')} aria-label="Makine Nabzı ana sayfa">
          <span class="brand-mark" aria-hidden="true">MN</span>
          <span>MAKİNE <b>NABZI</b></span>
        </a>
        <button class="menu-button" aria-label="Menüyü aç" aria-expanded="false">☰</button>
        <nav class="main-nav" aria-label="Ana menü">
          {nav.map(([label, path]) => <a href={href(path)}>{label}</a>)}
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand footer-brand" href={href('/')}>
            <span class="brand-mark">MN</span>
            <span>MAKİNE <b>NABZI</b></span>
          </a>
          <p>Mobil makine teknolojilerini; haber, teknik analiz, saha bilgisi ve veriyle tek platformda buluşturan bağımsız yayın.</p>
        </div>
        <div>
          <h3>Keşfet</h3>
          <a href={href('/haberler/')}>Haberler</a>
          <a href={href('/teknik-blog/')}>Teknik Merkez</a>
          <a href={href('/fuar-takvimi/')}>Fuar Takvimi</a>
        </div>
        <div>
          <h3>Alanlar</h3>
          <a href={href('/#sektorler')}>Sektörler</a>
          <a href={href('/#teknoloji')}>Teknoloji</a>
          <a href={href('/kaynaklar/')}>Kaynak Dizini</a>
        </div>
        <div>
          <h3>Makine Nabzı</h3>
          <a href={href('/hakkimizda/')}>Hakkımızda</a>
          <span>Doğrulanmış kaynaklar</span>
          <span>Teknik editoryal yaklaşım</span>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Makine Nabzı</span>
        <span>Makinenin kendisinden, onu mümkün kılan teknolojiye.</span>
      </div>
    </footer>

    <script is:inline>
      const button = document.querySelector('.menu-button');
      const nav = document.querySelector('.main-nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>