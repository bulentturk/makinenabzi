---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Makine Nabzı',
  description = 'İş makinaları, tarım, maden, liman ve mobil ekipman dünyasından haberler, teknik analizler ve kaynaklar.'
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['Haberler', '/haberler/'],
  ['Teknik Blog', '/teknik-blog/'],
  ['Fuar Takvimi', '/fuar-takvimi/'],
  ['Kaynaklar', '/kaynaklar/'],
  ['Hakkımızda', '/hakkimizda/'],
];
const href = (path:string) => `${base}${path}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b1118" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <title>{title === 'Makine Nabzı' ? title : `${title} | Makine Nabzı`}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand" href={href('/')} aria-label="Makine Nabzı ana sayfa">
          <span class="brand-mark" aria-hidden="true">M</span>
          <span>MAKİNE <b>NABZI</b></span>
        </a>
        <button class="menu-button" aria-label="Menüyü aç" aria-expanded="false">☰</button>
        <nav class="main-nav" aria-label="Ana menü">
          {nav.map(([label, path]) => <a href={href(path)}>{label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand footer-brand" href={href('/')}>
            <span class="brand-mark">M</span>
            <span>MAKİNE <b>NABZI</b></span>
          </a>
          <p>İş makinaları, tarım, maden, liman ve mobil ekipman teknolojilerinde doğrulanmış kaynaklara dayalı teknik yayın.</p>
        </div>
        <div>
          <h3>İçerikler</h3>
          <a href={href('/haberler/')}>Haberler</a>
          <a href={href('/teknik-blog/')}>Teknik Blog</a>
          <a href={href('/fuar-takvimi/')}>Fuar Takvimi</a>
        </div>
        <div>
          <h3>Referans</h3>
          <a href={href('/kaynaklar/')}>Kaynak Dizini</a>
          <a href={href('/hakkimizda/')}>Editoryal İlkeler</a>
        </div>
        <div>
          <h3>Makine Nabzı</h3>
          <span>Bağımsız teknik yayın altyapısı</span>
          <span>Kaynak gösterimi ve doğrulama odaklı</span>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Makine Nabzı</span>
        <span>Endüstriyi teknik bakışla takip edin.</span>
      </div>
    </footer>

    <script is:inline>
      const button = document.querySelector('.menu-button');
      const nav = document.querySelector('.main-nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>
