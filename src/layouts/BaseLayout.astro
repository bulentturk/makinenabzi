---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const siteName = 'Makine Nabzı';
const defaultDescription = 'İş makinaları, madencilik, liman, tarım, araç üstü ekipman ve elektrifikasyonda haber, teknik analiz ve teknoloji platformu.';
const {
  title = siteName,
  description = defaultDescription,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
  noindex = false
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['Sektörler', '/#sektorler'],
  ['Teknoloji', '/#teknoloji'],
  ['Haberler', '/haberler/'],
  ['İlanlar', '/ilanlar/'],
  ['Teknik Merkez', '/teknik-blog/'],
  ['Fuarlar', '/fuar-takvimi/'],
  ['Kaynaklar', '/kaynaklar/'],
];
const href = (path:string) => path.startsWith('#') ? path : `${base}${path}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const absolute = (path:string) => Astro.site ? new URL(path, Astro.site).href : path;
const ogImage = image ? (image.startsWith('http') ? image : absolute(image)) : absolute('/og-image.png');
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#081018" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="Makine Nabzı Haberler" href={href('/rss.xml')} />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>

    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-shell">
        <a class="brand" href={href('/')} aria-label="Makine Nabzı ana sayfa">
          <img class="brand-mark" src={href('/brand-mark.svg')} width="40" height="40" alt="" aria-hidden="true" />
          <span class="brand-name">MAKİNE <b>NABZI</b></span>
        </a>
        <button class="menu-button" aria-label="Menüyü aç" aria-expanded="false">☰</button>
        <nav class="main-nav" aria-label="Ana menü">
          {nav.map(([label, path]) => <a href={href(path)}>{label}</a>)}
        </nav>

        <a class="nav-account" href={href('/app/auth/')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="8" r="4"/></svg>
          <span>Hesap / Üye ol</span>
        </a>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand footer-brand" href={href('/')}>
            <img class="brand-mark" src={href('/brand-mark.svg')} width="40" height="40" alt="" aria-hidden="true" />
            <span class="brand-name">MAKİNE <b>NABZI</b></span>
          </a>
          <p>Mobil makine teknolojilerini; haber, teknik analiz, saha bilgisi ve veriyle tek platformda buluşturan bağımsız yayın.</p>
        </div>
        <div>
          <h3>Keşfet</h3>
          <a href={href('/haberler/')}>Haberler</a>
          <a href={href('/ilanlar/')}>İlanlar</a>
          <a href={href('/ilan-ver/')}>İlan ver</a>
          <a href={href('/rss.xml')}>RSS ile takip et</a>
          <a href={href('/teknik-blog/')}>Teknik Merkez</a>
          <a href={href('/formatlar/')}>İçerik Formatları</a>
          <a href={href('/fuar-takvimi/')}>Fuar Takvimi</a>
        </div>
        <div>
          <h3>Alanlar</h3>
          <a href={href('/#sektorler')}>Sektörler</a>
          <a href={href('/#teknoloji')}>Teknoloji</a>
          <a href={href('/kaynaklar/')}>Kaynak Dizini</a>
        </div>
        <div>
          <h3>Makine Nabzı</h3>
          <a href={href('/app/auth/')}>Hesap · Üye ol</a>
          <a href={href('/hakkimizda/')}>Hakkımızda</a>
          <a href={href('/iletisim/')}>İletişim</a>
          <a href={href('/gizlilik/')}>Gizlilik ve KVKK</a>
          <span>Doğrulanmış kaynaklar</span>
          <span>Teknik editoryal yaklaşım</span>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Makine Nabzı</span>
        <span>Makinenin kendisinden, onu mümkün kılan teknolojiye.</span>
      </div>
    </footer>

    <script is:inline>
      const button = document.querySelector('.menu-button');
      const nav = document.querySelector('.main-nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>
